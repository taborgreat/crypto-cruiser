# Copy to .env and export, or set these in your shell before `npm run dev` / `npm start`.
# (The server reads process.env directly; use `set -a; . ./.env` in bash or $env:NAME in PowerShell.)

# Server
PORT=8787
HOST=127.0.0.1
# HOST=0.0.0.0 (or `npm run dev:lan` / `npm run start:lan`) listens on every interface so another device on your
# LAN can open the app. Anyone on that network can then drive the connected wallet: trusted networks only.

# Solana RPC. The public endpoint works; a free Helius/Triton/QuickNode key gives a steadier websocket.
RPC_URL=https://api.mainnet-beta.solana.com
# RPC_WS_URL=wss://api.mainnet-beta.solana.com   (derived from RPC_URL when unset)

# Jupiter Perpetuals API
JUP_PERPS_API=https://perps-api.jup.ag/v1

# Update 1: optional Pyth Hermes SSE cross-check (Hermes needs an API key since 2026). Without it the
# Coinbase ticker stream is the secondary feed.
# PYTH_API_KEY=
# PYTH_HERMES_URL=https://hermes.pyth.network

# Candles are built locally from the tick history (data/ticks). On a cold start ATR warms up in ~15 minutes.
# Set to `exchange` to seed 1-minute candles once from Coinbase/Binance.US instead.
SEED_CANDLES=local

# Price history kept on disk and in memory (days). It feeds ghost ages, local candles and the rewind
# drive; the file is compacted to this window at startup. ~8 days is 1.4M ticks, ~25 MB.
TICK_HISTORY_DAYS=8

# Where the tick history and the live position ledger live
DATA_DIR=./data

# Update 13: instant signing. A dedicated trading wallet signs every Jupiter transaction on this machine
# (no Phantom approve screens). Created from the panel into data/trading-wallet.json, or supplied here as a
# JSON secret-key array or base58. HOT KEY: keep it small, fund from Phantom, withdraw when done.
# TRADING_WALLET_SECRET=
