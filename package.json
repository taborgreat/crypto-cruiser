{
  "name": "traffic",
  "version": "0.1.0",
  "private": true,
  "description": "TRAFFIC - a driver's-seat simulator for leveraged perp positions on Solana (Jupiter Perps)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:lan": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server:lan\" \"npm:dev:web:lan\"",
    "dev:server:lan": "tsx watch server/index.ts --lan",
    "dev:web:lan": "vite --config web/vite.config.ts --host",
    "dev:lan:https": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server:lan\" \"npm:dev:web:lan:https\"",
    "dev:web:lan:https": "vite --config web/vite.lan.config.ts",
    "start:lan": "tsx server/index.ts --serve-dist --lan",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts --serve-dist",
    "console": "tsx server/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "feed": "tsx server/cli.ts --feed-only"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "lightweight-charts": "^4.2.3",
    "three": "^0.186.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
